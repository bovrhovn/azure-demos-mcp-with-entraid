@page
@using McpEntra.MCP.WebClient.Options
@using Microsoft.Extensions.Options
@model McpEntra.MCP.WebClient.Pages.MCP.IndexPageModel
@inject IOptions<McpOptions> McpOptions
@{
    ViewData["Title"] = "MCP workspace";
    var toolCount = Model.ToolsInfo.Count;
}

<div class="mcp-page">
    <header class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-lg-between gap-4 mb-4 mb-lg-5">
        <div class="d-flex align-items-center gap-3">
            <div class="mcp-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="12" cy="12" r="3.2" />
                    <path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1" />
                </svg>
            </div>
            <div>
                <p class="mcp-overline mb-1">Model Context Protocol</p>
                <h1 class="mcp-page-title mb-1">MCP workspace</h1>
                <p class="text-secondary mb-0">Discover the tools available to your AI workflows.</p>
            </div>
        </div>
        <a asp-page="/MCP/CallAI" class="btn btn-primary mcp-primary-action">
            Open AI chat
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
        </a>
    </header>

    <section class="card mcp-connection-card border-0 shadow-sm mb-4 mb-lg-5" aria-label="MCP server connection">
        <div class="card-body p-4 p-lg-4">
            <div class="row align-items-center g-4">
                <div class="col-lg">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="mcp-status-dot" aria-hidden="true"></span>
                        <span class="badge rounded-pill mcp-connected-badge">Connected</span>
                    </div>
                    <p class="mcp-label mb-2">MCP base URL</p>
                    <div class="mcp-url-display">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1L10.9 5" />
                            <path d="M14 11a5 5 0 0 0-7.1-.1l-2 2A5 5 0 0 0 12 20l1.1-1" />
                        </svg>
                        <code>@McpOptions.Value.BaseUrl</code>
                    </div>
                </div>
                <div class="col-auto">
                    <div class="mcp-tool-stat">
                        <strong>@toolCount</strong>
                        <span>Available<br />tools</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section aria-labelledby="tools-heading">
        <div class="d-flex flex-column flex-sm-row justify-content-sm-between align-items-sm-end gap-2 mb-3">
            <div>
                <p class="mcp-overline mb-1">Capabilities</p>
                <h2 class="mcp-section-title mb-0" id="tools-heading">Available tools</h2>
            </div>
            <span class="text-secondary small">@toolCount @(toolCount == 1 ? "tool" : "tools") discovered</span>
        </div>

        @if (Model.ToolsInfo.Any())
        {
            <div class="row g-3 g-lg-4">
                @for (var index = 0; index < Model.ToolsInfo.Count; index++)
                {
                    var tool = Model.ToolsInfo[index];
                    <div class="col-md-6 col-xl-4">
                        <article class="card mcp-tool-card h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-4">
                                <div class="d-flex justify-content-between align-items-start mb-4">
                                    <span class="mcp-tool-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                            <path d="M12 3v18M3 12h18" />
                                            <circle cx="12" cy="12" r="8.5" />
                                        </svg>
                                    </span>
                                    <span class="mcp-card-number">@((index + 1).ToString("D2"))</span>
                                </div>
                                <h3 class="h5 fw-semibold mb-2">@tool.Name</h3>
                                <p class="text-secondary mb-4">@tool.Description</p>
                                <div class="mt-auto d-flex align-items-center gap-2 mcp-ready-text">
                                    <span class="mcp-status-dot" aria-hidden="true"></span>
                                    Ready to use
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm" role="status">
                <div class="card-body p-4 p-lg-5 text-center">
                    <span class="mcp-empty-icon mb-3" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <circle cx="12" cy="12" r="8.5" />
                            <path d="M8 12h8M12 8v8" />
                        </svg>
                    </span>
                    <h3 class="h5 fw-semibold">No tools available</h3>
                    <p class="text-secondary mb-0">The server did not return any discoverable MCP tools.</p>
                </div>
            </div>
        }
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/mcp-experience.css" asp-append-version="true" />
}
