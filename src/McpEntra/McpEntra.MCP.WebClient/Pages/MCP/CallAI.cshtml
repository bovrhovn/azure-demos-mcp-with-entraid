@page
@model McpEntra.MCP.WebClient.Pages.MCP.CallAIPageModel

@{
    ViewData["Title"] = "AI chat";
}

<div class="mcp-page">
    <header class="mb-4 mb-lg-5">
        <a asp-page="/MCP/Index" class="mcp-back-link mb-3">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M19 12H5M11 18l-6-6 6-6" />
            </svg>
            MCP workspace
        </a>
        <div class="d-flex align-items-center gap-3">
            <div class="mcp-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M5 18.5A8.5 8.5 0 1 1 19 18.5" />
                    <path d="M8 15h.01M12 12h.01M16 15h.01" stroke-linecap="round" stroke-width="2.5" />
                </svg>
            </div>
            <div>
                <p class="mcp-overline mb-1">AI assistant</p>
                <h1 class="mcp-page-title mb-1">Start a conversation</h1>
                <p class="text-secondary mb-0">Send a focused prompt to the configured AI service.</p>
            </div>
        </div>
    </header>

    <div class="row g-4">
        <div class="col-lg-7">
            <form method="post" class="card border-0 shadow-sm h-100" id="ai-prompt-form">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div>
                            <p class="mcp-overline mb-1">New prompt</p>
                            <h2 class="h4 fw-semibold mb-0">What can I help with?</h2>
                        </div>
                        <span class="badge rounded-pill mcp-ready-badge">Ready</span>
                    </div>
                    <label asp-for="Prompt" class="form-label fw-medium">Your message</label>
                    <textarea asp-for="Prompt" class="form-control mcp-prompt-input" rows="9" placeholder="Ask a question, describe a task, or share the context the AI needs..." autofocus></textarea>
                    <span asp-validation-for="Prompt" class="text-danger small d-block mt-2"></span>
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mt-4">
                        <span class="mcp-keyboard-hint">Press Ctrl or Command + Enter to send</span>
                        <button type="submit" class="btn btn-primary mcp-primary-action">
                            Send message
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M5 12h14M13 6l6 6-6 6" />
                            </svg>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-lg-5">
            <section class="card border-0 shadow-sm h-100 mcp-response-card" aria-labelledby="response-heading" aria-live="polite">
                <div class="card-body p-4 p-lg-5 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div>
                            <p class="mcp-overline mb-1">Response</p>
                            <h2 class="h4 fw-semibold mb-0" id="response-heading">AI output</h2>
                        </div>
                        @if (Model.HasResponse)
                        {
                            <span class="badge rounded-pill mcp-response-badge">Received</span>
                        }
                    </div>
                    @if (Model.HasResponse)
                    {
                        <div class="mcp-response-copy">@Model.AiResponse</div>
                    }
                    else
                    {
                        <div class="mcp-response-placeholder flex-grow-1">
                            <span class="mcp-empty-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M5 18.5A8.5 8.5 0 1 1 19 18.5" />
                                    <path d="M8 15h.01M12 12h.01M16 15h.01" stroke-linecap="round" stroke-width="2.5" />
                                </svg>
                            </span>
                            <p class="fw-semibold mb-1">Your response will appear here</p>
                            <small class="text-secondary">Send a message to begin the conversation.</small>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>

    @if (Model.ToolsInfo.Any())
    {
        <section class="card border-0 shadow-sm mcp-tool-context mt-4" aria-labelledby="tool-context-heading">
            <div class="card-body p-3 p-lg-4">
                <div class="d-flex flex-column flex-md-row align-items-md-center gap-2 gap-md-4">
                    <div class="flex-shrink-0">
                        <p class="mcp-overline mb-1">MCP context</p>
                        <h2 class="h6 fw-semibold mb-0" id="tool-context-heading">Available tools</h2>
                    </div>
                    <ul class="list-unstyled d-flex flex-wrap gap-2 mb-0" aria-label="Available MCP tools">
                        @foreach (var tool in Model.ToolsInfo)
                        {
                            <li>
                                <span class="mcp-tool-chip" title="@tool.Description">
                                    <span class="mcp-chip-dot" aria-hidden="true"></span>
                                    @tool.Name
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </section>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/mcp-experience.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        document.getElementById("Prompt").addEventListener("keydown", function (event) {
            if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
                event.preventDefault();
                document.getElementById("ai-prompt-form").requestSubmit();
            }
        });
    </script>
}